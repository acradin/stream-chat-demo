# Copy to backend/.env. Loaded only by the service server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Native desktop realtime mode (screen only); configured by the operator.
REALTIME_MODEL=gpt-realtime-2.1

# A separate random service token, at least 32 characters.
# Use the same development account token in apps/desktop/.env.
CHAT_SERVICE_TOKEN=

# Optional multiple accounts; takes priority over CHAT_SERVICE_TOKEN.
# CHAT_SERVICE_ACCOUNTS='{"account-a":"replace-with-a-unique-random-token-at-least-32-characters"}'

# Optional CHZZK publishing: register a developer application first.
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
CHZZK_CHANNEL_ID=
# CHZZK_CHANNEL_ID also accepts a full https://chzzk.naver.com/live/... URL.
CHZZK_REDIRECT_URI=http://localhost:8767/oauth/chzzk/callback
# Only this service account may use the operator's CHZZK connection.
CHZZK_SERVICE_ACCOUNT=development

# Optional remote browser approval, on a single server with persistent storage.
# Register CHAT_PUBLIC_URL + /oauth/chzzk/callback in the CHZZK developer center.
# CHAT_PUBLIC_URL=https://your-service.example.com
# CHAT_HOST=0.0.0.0
# PORT=8080
# CHAT_STATE_DIR=/var/lib/stream-chat
